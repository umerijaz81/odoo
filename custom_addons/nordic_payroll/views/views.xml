<odoo>
  <data>
    <!-- Kanban View -->
    <record id="view_nordic_payslip_kanban" model="ir.ui.view">
      <field name="name">nordic.payslip.kanban</field>
      <field name="model">nordic.payslip</field>
      <field name="arch" type="xml">
        <kanban default_group_by="state">
          <field name="name"/>
          <field name="employee_id"/>
          <field name="net_amount"/>
          <field name="state"/>
          <templates>
            <t t-name="card">
                <div class="oe_kanban_global_click">
                    <div class="o_kanban_record_top">
                        <div class="o_kanban_record_headings">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                        </div>
                    </div>
                    <div class="o_kanban_record_body">
                        <div><field name="employee_id"/></div>
                        <div>Net: <field name="net_amount" widget="monetary"/></div>
                    </div>
                    <div class="o_kanban_record_bottom">
                        <div class="oe_kanban_bottom_left">
                             <field name="activity_ids" widget="kanban_activity"/>
                        </div>
                        <div class="oe_kanban_bottom_right">
                            <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'verify': 'warning', 'done': 'success', 'cancel': 'danger'}}"/>
                        </div>
                    </div>
                </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <!-- Graph View -->
    <record id="view_nordic_payslip_graph" model="ir.ui.view">
      <field name="name">nordic.payslip.graph</field>
      <field name="model">nordic.payslip</field>
      <field name="arch" type="xml">
        <graph string="Payroll Analysis" type="bar" sample="1">
          <field name="employee_id"/>
          <field name="gross_amount" type="measure"/>
          <field name="net_amount" type="measure"/>
          <field name="tax_amount" type="measure"/>
        </graph>
      </field>
    </record>

    <!-- Pivot View -->
    <record id="view_nordic_payslip_pivot" model="ir.ui.view">
      <field name="name">nordic.payslip.pivot</field>
      <field name="model">nordic.payslip</field>
      <field name="arch" type="xml">
        <pivot string="Payroll Analysis" sample="1">
          <field name="employee_id" type="row"/>
          <field name="date_from" type="col"/>
          <field name="gross_amount" type="measure"/>
          <field name="net_amount" type="measure"/>
        </pivot>
      </field>
    </record>

    <!-- Salary Rule Views -->
    <record model="ir.ui.view" id="view_nordic_salary_rule_list">
      <field name="name">nordic.salary.rule.list</field>
      <field name="model">nordic.salary.rule</field>
      <field name="arch" type="xml">
        <list string="Salary Rules">
          <field name="sequence" widget="handle"/>
          <field name="name"/>
          <field name="code"/>
          <field name="category"/>
          <field name="amount_select"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="view_nordic_salary_rule_form">
      <field name="name">nordic.salary.rule.form</field>
      <field name="model">nordic.salary.rule</field>
      <field name="arch" type="xml">
        <form string="Salary Rule">
          <sheet>
            <group>
              <group>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
              </group>
              <group>
                <field name="sequence"/>
                <field name="amount_select"/>
              </group>
            </group>
            <notebook>
              <page string="Calculation" name="calculation">
                <group>
                  <field name="amount_fix" invisible="amount_select != 'fix'"/>
                  <field name="amount_percentage" invisible="amount_select != 'percentage'"/>
                  <field name="amount_python_compute" invisible="amount_select != 'python'"/>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Payslip List & Form -->
    <record id="view_nordic_payslip_list" model="ir.ui.view">
      <field name="name">nordic.payslip.list</field>
      <field name="model">nordic.payslip</field>
      <field name="arch" type="xml">
        <list string="Payslips">
          <field name="name"/>
          <field name="employee_id"/>
          <field name="date_from"/>
          <field name="date_to"/>
          <field name="gross_amount" sum="Total Gross"/>
          <field name="net_amount" sum="Total Net"/>
          <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
        </list>
      </field>
    </record>

    <record id="view_nordic_payslip_form" model="ir.ui.view">
      <field name="name">nordic.payslip.form</field>
      <field name="model">nordic.payslip</field>
      <field name="arch" type="xml">
        <form string="Payslip">
          <header>
            <button name="compute_sheet" string="Compute Sheet" type="object" class="oe_highlight" invisible="state != 'draft'"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,verify,done"/>
          </header>
          <sheet>
            <div class="oe_title">
              <h1><field name="name"/></h1>
            </div>
            <group>
              <group>
                <field name="employee_id"/>
                <field name="struct_id"/>
              </group>
              <group>
                <field name="date_from"/>
                <field name="date_to"/>
              </group>
            </group>
            <group>
                <group string="Totals">
                    <field name="gross_amount"/>
                    <field name="tax_amount"/>
                    <field name="net_amount" class="oe_subtotal_footer_separator"/>
                </group>
            </group>
            <notebook>
              <page string="Income Details" name="details">
                <field name="line_ids">
                  <list>
                    <field name="sequence"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="amount"/>
                  </list>
                </field>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="activity_ids"/>
            <field name="message_ids"/>
          </div>
        </form>
      </field>
    </record>

    <!-- Actions -->
    <record model="ir.actions.act_window" id="action_nordic_payslip_dashboard">
      <field name="name">Payroll Dashboard</field>
      <field name="res_model">nordic.payslip</field>
      <field name="view_mode">graph,pivot,kanban</field>
    </record>

    <record model="ir.actions.act_window" id="action_nordic_payslip">
      <field name="name">Payslips</field>
      <field name="res_model">nordic.payslip</field>
      <field name="view_mode">kanban,list,form</field>
    </record>

    <record model="ir.actions.act_window" id="action_nordic_salary_rule">
      <field name="name">Salary Rules</field>
      <field name="res_model">nordic.salary.rule</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="action_nordic_payroll_structure">
      <field name="name">Payroll Structures</field>
      <field name="res_model">nordic.payroll.structure</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Structure -->
    <menuitem name="Nordic Payroll" id="nordic_payroll_menu_root" web_icon="nordic_payroll,static/description/icon.png" sequence="10"/>

    <menuitem name="Dashboard" id="menu_nordic_dashboard" parent="nordic_payroll_menu_root" action="action_nordic_payslip_dashboard" sequence="1"/>
    <menuitem name="Payslips" id="menu_nordic_payslip" parent="nordic_payroll_menu_root" action="action_nordic_payslip" sequence="10"/>
    
    <menuitem name="Configuration" id="menu_nordic_config" parent="nordic_payroll_menu_root" sequence="100"/>
    <menuitem name="Salary Rules" id="menu_nordic_salary_rule" parent="menu_nordic_config" action="action_nordic_salary_rule" sequence="10"/>
    <menuitem name="Structures" id="menu_nordic_payroll_structure" parent="menu_nordic_config" action="action_nordic_payroll_structure" sequence="20"/>

  </data>
</odoo>
