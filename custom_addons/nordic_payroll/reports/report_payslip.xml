<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_nordic_payslip" model="ir.actions.report">
        <field name="name">Nordic Payslip</field>
        <field name="model">nordic.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nordic_payroll.report_payslip_template</field>
        <field name="report_file">nordic_payroll.report_payslip_template</field>
        <field name="binding_model_id" ref="model_nordic_payslip"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_payslip_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center font-weight-bold" style="font-size: 24px; color: #1e3a8a; margin-bottom: 20px;">
                            Nordic Payroll Payslip
                        </div>
                        
                        <div class="row">
                            <div class="col-6">
                                <strong>Employee:</strong> <span t-field="o.employee_id.name"/><br/>
                                <strong>Date:</strong> <span t-field="o.date_from"/> to <span t-field="o.date_to"/>
                            </div>
                            <div class="col-6 text-right">
                                <strong>Reference:</strong> <span t-field="o.name"/><br/>
                                <strong>Structure:</strong> <span t-field="o.struct_id.name"/>
                            </div>
                        </div>

                        <table class="table table-sm mt32" style="border: 1px solid #e5e7eb;">
                            <thead style="background-color: #f3f4f6;">
                                <tr>
                                    <th>Code</th>
                                    <th>Description</th>
                                    <th class="text-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr t-att-style="'font-weight: bold;' if line.category == 'NET' else ''">
                                        <td><span t-field="line.code"/></td>
                                        <td><span t-field="line.name"/></td>
                                        <td class="text-right">
                                            <span t-esc="line.amount" t-options='{"widget": "monetary", "display_currency": o.env.company.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row mt32">
                            <div class="col-7"></div>
                            <div class="col-5">
                                <table class="table table-sm">
                                    <tr class="border-black">
                                        <td><strong>Gross Total</strong></td>
                                        <td class="text-right"><span t-field="o.gross_amount" t-options='{"widget": "monetary", "display_currency": o.env.company.currency_id}'/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Tax Total</strong></td>
                                        <td class="text-right"><span t-field="o.tax_amount" t-options='{"widget": "monetary", "display_currency": o.env.company.currency_id}'/></td>
                                    </tr>
                                    <tr class="border-black o_total">
                                        <td><strong>NET PAY</strong></td>
                                        <td class="text-right"><strong><span t-field="o.net_amount" t-options='{"widget": "monetary", "display_currency": o.env.company.currency_id}'/></strong></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
